# Automatic HTTPS (Let's Encrypt) for $DOMAIN, proxying the website and the
# WebSocket to the game server.
{$DOMAIN} {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}

# Extra sites that live only on the server, outside this repo (e.g. the deal tracker in
# /etc/caddy-sites/deals.caddy). No matching files is fine: Caddy just skips the import.
import /etc/caddy/sites/*.caddy
